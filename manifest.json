{
  "id": "almanac",
  "contexts": ["household", "shared_space"],
  "name": "Almanac",
  "version": "1.0.0",
  "description": "Track recurring seasonal events — first frost, first blooms, first robin — and watch patterns emerge year over year.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["nature", "seasons", "garden", "outdoor", "tracking"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "row_policies": {
    "event_types": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    },
    "observations": {
      "kind": "owner_or_visibility",
      "member_column": "logged_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    }
  },
  "member_references": {
    "event_types": { "column": "created_by", "on_removed": "keep" },
    "observations": { "column": "logged_by", "on_removed": "keep" }
  },
  "nav": { "label": "Almanac" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT t.name AS title, t.icon AS icon, CAST(o.year AS TEXT) AS subtitle, o.observed_date AS at FROM app_almanac__observations o JOIN app_almanac__event_types t ON t.id = o.event_type_id WHERE substr(o.observed_date, 6, 5) = substr(:today, 6, 5) AND o.observed_date <> :today ORDER BY o.observed_date DESC LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "subtitle": "subtitle",
      "icon": "icon",
      "when": "at"
    }
  },
  "publishes": ["almanac.observation_logged"],
  "publish_acls": {
    "almanac.observation_logged": { "require_role": "member" }
  },
  "widget": { "label": "Almanac", "size": "small", "entrypoint": "widget.html" },
  "icon": "📅",
  "db_plaintext_columns": ["observed_date"],
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["observations_history"]
  }
}
